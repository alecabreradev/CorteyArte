<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="8dp">

    <ImageView
        android:id="@+id/logoWidget"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/logo_app"
        android:contentDescription="@string/app_name"/>

    <TextView
        android:id="@+id/textReservas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reservas"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_toEndOf="@id/logoWidget"
        android:layout_marginStart="8dp"
        android:layout_alignTop="@id/logoWidget"/>

    <TextView
        android:id="@+id/textDetalleReservas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalles de próximas reservas"
        android:layout_below="@id/textReservas"
        android:layout_toEndOf="@id/logoWidget"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />


</RelativeLayout>
